{
  "name": "@afixt/accessible-cookie-banner",
  "version": "1.2.1",
  "description": "A customizable, WCAG-conformant cookie consent banner with GDPR, CCPA compliance",
  "type": "module",
  "main": "dist/consent.js",
  "module": "dist/consent.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ACCESSIBILITY.md"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:visual": "playwright test --config=playwright-visual.config.js",
    "test:visual:headed": "playwright test --config=playwright-visual.config.js --headed",
    "test:visual:update": "playwright test --config=playwright-visual.config.js --update-snapshots",
    "test:all": "npm run test",
    "clean": "rimraf dist",
    "css:build": "postcss src/css/main.css -o dist/banner.css",
    "css:watch": "postcss src/css/main.css -o dist/banner.css --watch",
    "dev": "npm run css:build && rollup -c -w",
    "build": "npm run clean && npm run css:build && rollup -c",
    "serve": "http-server . -p 8080",
    "start": "npm run build && npm run serve",
    "docs": "jsdoc -c jsdoc.json",
    "docs:md": "jsdoc2md 'src/js/*.js' > docs/API.md",
    "docs:clean": "rimraf docs/api",
    "docs:build": "npm run docs:clean && npm run docs && npm run docs:md",
    "size": "size-limit",
    "size:analyze": "npm run build && size-limit && npm run analyze",
    "analyze": "npx webpack-bundle-analyzer dist/consent.js --mode static --report bundle-report.html --no-open",
    "prepublishOnly": "npm run test:all && npm run build",
    "install:playwright": "playwright install",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:first": "commit-and-tag-version --first-release",
    "release:dry-run": "commit-and-tag-version --dry-run",
    "check": "npm run lint && npm run format:check && npm run lint:css && npm run lint:md",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore CHANGELOG.md --ignore dist",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:css:fix": "stylelint 'src/**/*.css' --fix",
    "lint:cpd": "jscpd . --config .jscpd.json",
    "lint:cpd:ci": "jscpd . --config .jscpd.json --threshold 5",
    "security:audit": "npm audit",
    "security:check": "npm audit --audit-level=high",
    "lint:licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow 'MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;CC0-1.0;Unlicense;0BSD;BlueOak-1.0.0;CC-BY-4.0;Python-2.0'",
    "check:all": "npm run check && npm run lint:cpd:ci && npm run lint:licenses && npm test",
    "bootstrap": "bash scripts/bootstrap.sh"
  },
  "keywords": [
    "accessibility",
    "WCAG",
    "cookie",
    "consent",
    "GDPR",
    "CCPA",
    "banner",
    "a11y"
  ],
  "author": "Karl Groves <karlgroves@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AFixt/cookie-banner.git"
  },
  "bugs": {
    "url": "https://github.com/afixt/cookie-banner/issues"
  },
  "homepage": "https://github.com/afixt/cookie-banner#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@size-limit/file": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^30.4.1",
    "commit-and-tag-version": "^13.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.2.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.7.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jscpd": "^5.0.12",
    "jsdoc": "^4.0.5",
    "jsdoc-to-markdown": "^9.1.3",
    "license-checker-rseidelsohn": "^4.4.2",
    "lint-staged": "17.1.1",
    "markdownlint-cli": "^0.49.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.22",
    "postcss-calc": "^10.1.1",
    "postcss-cli": "^11.0.1",
    "postcss-custom-properties": "^15.0.1",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.2",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "size-limit": "^12.1.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.0",
    "webpack-bundle-analyzer": "^5.3.1"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "size-limit": [
    {
      "path": "./dist/consent.min.js",
      "limit": "15kb",
      "gzip": true
    },
    {
      "path": "./dist/consent.js",
      "limit": "35kb"
    },
    {
      "path": "./dist/banner.css",
      "limit": "8kb",
      "gzip": true
    }
  ]
}
