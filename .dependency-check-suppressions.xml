<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        Reviewed findings for the OWASP Dependency-Check gate in
        .github/workflows/security.yml (fails at CVSS >= 7).
        Reference: fleet-security templates/dependency-check.yml
        (AFixt/fleet-security#4).

        Suppress only a finding that has been reviewed and is not exploitable
        here. Every entry needs a reason, the reviewer and an `until` date, so
        it can't quietly outlive its justification. Once `until` passes, the
        finding fails the gate again and has to be looked at again.
        `fleet-security depcheck-status` flags an entry that is missing either.

        A real vulnerability is fixed (upgrade, override or replace the
        dependency), not suppressed.
    -->

    <!--
        False positive: a LOW-confidence CPE match on the wrong package.
    -->
    <suppress until="2026-12-02Z">
        <notes>False positive. CVE-2017-16115 is a ReDoS in the `timespan` npm package (cpe timespan_project:timespan). Dependency-Check matched it, at LOW confidence, to `time-span` 5.1.0 (sindresorhus/time-span), an unrelated package that only measures elapsed time; it arrives dev-only via eslint-plugin-unicorn -> is-identifier -> super-regex. Reviewed by Claude Code for Karl Groves, 2026-10-04, for AFixt/fleet-security#4.</notes>
        <packageUrl regex="true">^pkg:npm/time-span@.*$</packageUrl>
        <cpe>cpe:/a:timespan_project:timespan</cpe>
    </suppress>
</suppressions>
