# EditorConfig — https://editorconfig.org
# Values here intentionally mirror .prettierrc so that editors and Prettier
# agree; changing one without the other will cause formatting churn.

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Trailing whitespace is significant in Markdown (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false

# Generated by commit-and-tag-version; left exactly as written.
[CHANGELOG.md]
insert_final_newline = false
trim_trailing_whitespace = false
